+    private static void WriteAssetBundleCsv(ManifestScheme manifest, string outputFile)
+    {
+        var bundlesByIndex = manifest.Bundles.ToDictionary(x => x.BundleIndex);
+        using var writer = new StreamWriter(outputFile, false, new UTF8Encoding(false));
+        writer.WriteLine("asset_path,bundle_index,bundle_name,asset_size");
+        foreach (var asset in manifest.Assets)
+        {
+            bundlesByIndex.TryGetValue(asset.BundleIndex, out var bundle);
+            writer.WriteLine($"{Csv(asset.Path)},{asset.BundleIndex},{Csv(bundle?.Name ?? string.Empty)},{asset.AssetSize}");
+        }
+    }
+
+    private static string Csv(string value) => $"\"{value.Replace("\"", "\"\"")}\"";
