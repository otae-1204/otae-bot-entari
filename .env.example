# Entari / Satori
# Add one object per LLOneBot Satori WebSocket endpoint. Ports must be different
# when multiple LLOneBot instances run on the same host.
SATORI_CLIENTS=[{"host":"localhost","port":"5500","path":"","token":"CHANGE_ME"}]
SUPERUSERS=["2461673400"]

# Base64 编码的 32 字节密钥；未配置时禁用终末地账号绑定与凭据读取。
# 生成示例：python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENDFIELD_CREDENTIAL_KEY=

# Network proxy (optional)
HTTP_PROXY=
HTTPS_PROXY=

# General LLM diagnostics (optional)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# HYW 搜索问答（/q、/hyw、/何意味）
# hyw=独立配置；llm=整组使用 LLM_*；steam=整组使用 STEAM_LLM_*
HYW_CONFIG_SOURCE=hyw
HYW_API_KEY=
HYW_BASE_URL=https://openrouter.ai/api/v1
HYW_MODEL=gpt-4o
HYW_RENDER=true
# 模型和用户图片下载代理；留空时使用上述全局代理
# 填 direct 可仅让 HYW 直连，不继承全局代理
HYW_PROXY=
# 搜索/网页读取可单独指定代理；留空沿用 HYW_PROXY，填 direct 则直连
HYW_SEARCH_PROXY=

# Cursor Grok Bot 应用（/grok、/grokbot），通过 Tailscale/SSH 私网网关直连
# 网关基址，不带 /v1 或 /api；固定绕过全局代理
GROKBOT_GATEWAY_URL=
# gateway.json 中的 token，填写原文（不含 Bearer 前缀）
GROKBOT_GATEWAY_TOKEN=
# 可选：原 QQBOT UUID，仅供只读诊断；问答自动使用各会话独立 Bot
GROKBOT_AGENT_ID=
# 排队和每次任务的等待上限（分别计时，单位秒）
GROKBOT_TIMEOUT=300
# 包含正在处理的请求；同一用户可多次提交，同会话依次处理
GROKBOT_MAX_PENDING=8
# 不同会话最多同时处理的数量
GROKBOT_MAX_CONCURRENT=4
# 留空使用 plugins/grok_bot/persona.md（花园多惠）；也可填写自定义 UTF-8 文件路径
GROKBOT_PERSONA_FILE=
# 默认关闭；SuperUser 在目标群发送 /功能 开启 grok 后才可使用

# Steam
STEAM_API_KEYS=KEY1,KEY2,KEY3
STEAM_REQUEST_INTERVAL=300
STEAM_LLM_API_KEY=
STEAM_LLM_BASE_URL=https://api.deepseek.com
STEAM_LLM_MODEL=deepseek-v4-flash
STEAM_DISABLE_BROADCAST_ON_STARTUP=false

# MCSManager
MCSM_PANEL_URL=http://127.0.0.1:23333
MCSM_API_KEY=
MCSM_GROUP_WHITELIST=[]

# Minecraft
MC_BROADCAST_INTERVAL=300

# Bilibili
BILI_SESSDATA=
BILI_BUVID3=
BILI_DM_IMG_LIST=
BILI_DM_IMG_STR=
BILI_DM_COVER_IMG_STR=
BILI_RSSHUB_BASE_URLS=https://rss.materium.io,https://rsshub.app

# LLOneBot OneBot HTTP fallback for request handling (optional)
ONEBOT_HTTP_URL=http://127.0.0.1:3000
ONEBOT_ACCESS_TOKEN=
