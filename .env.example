# .env 只放密钥，以及少数由第三方代码直接从进程环境读取的变量。
# 其余全部配置在 entari.yml（从 entari.example.yml 复制），它用 "${{ env.名字 :- }}" 引用这里的密钥。
# 真实环境变量优先于本文件。值里不能出现 ${（python-dotenv 会展开）。
# 旧部署请用 scripts/convert_config.py 转换，见 README「配置」。

# ── 连接令牌（entari.yml 的 basic.network[].token / plugins.server.adapters[].access_token）──
SATORI_TOKEN_1=
# SATORI_TOKEN_2=
# SATORI_TOKEN_3=
# ONEBOT_TOKEN_1=

# ── 凭据加密密钥：Base64 编码的 32 字节，留空则禁用对应的账号绑定 ──
# 生成：python -c "import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# 两个游戏各用各的，明日方舟不会回退到终末地的密钥。
ENDFIELD_CREDENTIAL_KEY=
ARKNIGHTS_CREDENTIAL_KEY=

# ── API Key / 令牌 / Cookie ──
LLM_API_KEY=
HYW_API_KEY=
# Steam Web API Key，多个用逗号分隔轮换
STEAM_API_KEYS=
# 只有一个 Key 时也可以用 STEAM_API_KEY（plugins.steamInfo.api_key）
# STEAM_API_KEY=
STEAM_LLM_API_KEY=
BILI_SESSDATA=
BILI_BUVID3=
BILI_DM_IMG_LIST=
BILI_DM_IMG_STR=
BILI_DM_COVER_IMG_STR=

# ── 第三方代码直接从进程环境读取（不经 entari.yml）──
# 全局代理：HTTP 库、浏览器出图、Steam、HYW（未单独设代理时）都会用；带账号密码时同样写这里
HTTP_PROXY=
HTTPS_PROXY=
# NO_PROXY=
# 自定义 CA：SSL_CERT_FILE= / SSL_CERT_DIR=
# HYW 用 Google 服务账号时的 JSON 路径（也可写在 entari.yml 的 plugins.hyw.credentials_file）
GOOGLE_APPLICATION_CREDENTIALS=
# hyw-frontier：瞬时失败的退避重试（单次最多尝试次数、退避起点秒、单次等待上限秒、一次问答累计等待上限秒）
HYW_RETRY_ATTEMPTS=3
HYW_RETRY_BASE_DELAY=0.5
HYW_RETRY_MAX_DELAY=8.0
HYW_RETRY_BUDGET=20.0
# hyw-frontier：搜索 / 网页读取用 jina 或 parallel 时的 Key
# JINA_API_KEY=
# PARALLEL_API_KEY=
